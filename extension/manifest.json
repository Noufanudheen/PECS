{
  "manifest_version": 3,
  "name": "PECS Auto-Clipboard",
  "version": "1.0",
  "description": "Automatically syncs system clipboard to the PECS web app.",
  "permissions": [
    "clipboardRead",
    "storage",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "*://localhost/*",
    "*://127.0.0.1/*",
    "*://*.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Toggle PECS Sync"
  },
  "content_scripts": [
    {
      "matches": [
        "*://localhost/*",
        "*://127.0.0.1/*",
        "*://*.onrender.com/*"
      ],
      "js": ["content.js"]
    }
  ]
}
